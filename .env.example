# Postgres connection string (Supabase: use the pooled connection string, port 6543)
DATABASE_URL=
# Gemini API key for claim extraction and guide drafting (server-side only). Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated model fallback list, tried in order when a model hits its free-tier quota
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# Tavily search API key; live research is disabled without it. Free plan: https://app.tavily.com
TAVILY_API_KEY=
# Guide generations allowed per IP per hour, per server instance (default 5; global cap 30/hour/instance)
GENERATE_RATE_LIMIT_PER_HOUR=5
# Public base URL of the deployed site, used for absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Repo link shown in the site footer (hidden if unset)
NEXT_PUBLIC_REPO_URL=https://github.com/saishashank-a/oauth-launchpad
