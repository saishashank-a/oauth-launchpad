# Postgres connection string (Supabase: use the pooled connection string, port 6543)
DATABASE_URL=
# Anthropic API key for claim extraction and guide synthesis (server-side only)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: Anthropic API base URL / proxy (read automatically by the SDK)
ANTHROPIC_BASE_URL=
# Tavily search API key; live research is disabled without it
TAVILY_API_KEY=
# Guide generations allowed per IP per hour, per server instance (default 5; global cap 30/hour/instance)
GENERATE_RATE_LIMIT_PER_HOUR=5
# Public base URL of the deployed site, used for absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Repo link shown in the site footer (hidden if unset)
NEXT_PUBLIC_REPO_URL=https://github.com/saishashank-a/oauth-launchpad
